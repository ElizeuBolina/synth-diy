[Unit]
Description=Synth DIY FluidSynth SoundFont engine
After=sound.target

[Service]
Type=simple
User=synth
Group=audio
LimitRTPRIO=80
LimitMEMLOCK=infinity
Nice=-10
# SoundFont options:
# - /usr/share/sounds/sf2/FluidR3_GM.sf2: larger, better quality, slower boot.
# - /usr/share/sounds/sf2/GeneralUser-GS.sf2: balanced GM/GS test bank, good FluidSynth support.
# - /usr/share/sounds/sf2/TimGM6mb.sf2: smaller test bank, faster boot.
ExecStart=/usr/bin/fluidsynth -is -a alsa -m alsa_seq -o audio.alsa.device=plughw:0,0 -o synth.gain=0.75 -o synth.reverb.damp=0.3 -o synth.reverb.level=0.7 -o synth.reverb.room-size=0.5 -o synth.reverb.width=0.8 -o synth.chorus.depth=3.6 -o synth.chorus.level=0.55 -o synth.chorus.nr=4 -o synth.chorus.speed=0.36 /usr/share/sounds/sf2/GeneralUser-GS.sf2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
